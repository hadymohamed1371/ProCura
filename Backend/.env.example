PORT=5000
NODE_ENV=development
MONGO_INITDB_ROOT_USERNAME=procura
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=procura
MONGO_URI=mongodb://procura:replace-with-a-long-random-password@localhost:27017/procura?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
